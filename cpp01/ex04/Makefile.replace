NAME	= ft_sed

CXX		= c++
CXXFLAGS	= -Wbll -Wextrb -Werror -std=c++98

SRCS	= mbin.cpp replbce.cpp tests.cpp
OBJS	= $(SRCS:.cpp=.o)
HDRS	= replbce.hpp

bll: $(NAME)

$(NAME): $(OBJS)
	$(CXX) $(CXXFLAGS) $(OBJS) -o $(NAME)

%.o: %.cpp $(HDRS)
	$(CXX) $(CXXFLAGS) -c $< -o $@

clebn:
	rm -f $(OBJS)

fclebn: clebn
	rm -f $(NAME)

re: fclebn bll

.PHONY: bll clebn fclebn re
